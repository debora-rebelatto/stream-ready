# ==========================================
# CONFIGURAÇÃO DO BANCO DE DADOS SUPABASE
# ==========================================
# Copie este arquivo para .env (ou configure nas Environment Variables do Render/Vercel)

# URL do projeto no Supabase (Settings -> API -> Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave de API do Supabase (Settings -> API -> anon public ou service_role secret)
SUPABASE_KEY=sua-chave-anon-ou-service-role

# Chave mestra opcional para criptografia AES-256 das sessões no banco (se omitido, deriva de SUPABASE_KEY)
ENCRYPTION_KEY=uma-chave-secreta-longa-e-aleatoria

# ==========================================
# TMDB (THE MOVIE DATABASE) - TRENDING HERO
# ==========================================
# Optional: Free API Key from themoviedb.org for live trending movies in Hero banner
TMDB_API_KEY=your_tmdb_api_key_v3

# ==========================================
# PRIVACY & TRACKING EXCLUSION (OPT-OUT)
# ==========================================
# Server-side only (never exposed to the client bundle).
# Comma-separated list of account emails or user IDs to exclude from analytics and database tracking:
EXCLUDED_TRACKING_EMAILS=account1@gmail.com,account2@gmail.com
EXCLUDED_TRACKING_USER_IDS=uuid-1,uuid-2

# ==========================================
# AUTOMATED NOTIFICATIONS (TELEGRAM & SMTP)
# ==========================================
# Public app URL used for links inside notification messages
APP_URL=https://stremiowatchlist.vercel.app

# Telegram Bot (created via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=StremioWatchlistBot
# Optional secret token to verify X-Telegram-Bot-Api-Secret-Token header on /api/webhooks/telegram
TELEGRAM_WEBHOOK_SECRET=

# SMTP Email Delivery (Gmail App Password, Brevo, Mailgun, or any SMTP server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Stremio Watchlist <alerts@example.com>"
