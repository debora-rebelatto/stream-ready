# ==========================================
# CONFIGURAÇÃO DO BANCO DE DADOS SUPABASE
# ==========================================
# Copie este arquivo para .env (ou configure nas Environment Variables do Render/Vercel)

# URL do projeto no Supabase (Settings -> API -> Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave de API do Supabase (Settings -> API -> anon public ou service_role secret)
SUPABASE_KEY=sua-chave-anon-ou-service-role
