{
  "name": "stremio-watchlist-1080p",
  "version": "1.0.0",
  "description": "Stremio addon with personal watchlist and good quality movie tracking (Good Quality Tracker)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build:server && concurrently \"node --watch server.js\" \"vite\"",
    "dev:server": "npm run build:server && node --watch server.js",
    "dev:client": "vite",
    "build:server": "node scripts/build-server.js",
    "build": "npm run build:server && vite build",
    "vercel-build": "npm run build:server && vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:server": "jest tests/server",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "watchlist",
    "good-quality-tracker",
    "movies"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jest": "^30.5.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
